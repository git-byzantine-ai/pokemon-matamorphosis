+    request->mon.otId=GetMonData(mon,MON_DATA_OT_ID);
+    request->mon.species=GetMonData(mon,MON_DATA_SPECIES);
+    request->mon.level=GetMonData(mon,MON_DATA_LEVEL);
+    request->mon.valid=TRUE;
